DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
FRONTEND_URL=http://127.0.0.1:8080
VITE_API_BASE_URL=http://127.0.0.1:8010/api
PUBLIC_APP_URL=http://127.0.0.1:8080
ACCOUNT_CONFIRMATION_URL=http://127.0.0.1:8080/confirm-account
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DATABASE_URL=
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=hello@braziliansushi.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
DJANGO_TIME_ZONE=America/Chicago

# Stripe Checkout (optional). Leave all three blank to keep checkout exactly
# as it is without payments — nothing else in the app changes.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://127.0.0.1:8080/track-order
STRIPE_CHECKOUT_CANCEL_URL=http://127.0.0.1:8080/checkout

# Error monitoring (optional). Leave blank to run without Sentry.
DJANGO_SENTRY_DSN=
DJANGO_SENTRY_ENVIRONMENT=development
DJANGO_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
